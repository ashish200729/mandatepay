{
  "info": {
    "name": "MandatePay MVP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manual local/Sandbox request collection. Financial writes run only when explicitly sent. No live credentials or mock success responses included. Read docs/api/POSTMAN.md first."
  },
  "variable": [
    {
      "key": "apiUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "appUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "mandateId",
      "value": "",
      "type": "string"
    },
    {
      "key": "proposalId",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "shoppingRequestKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "proposalRequestKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "refundRequestKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "vaultConsentVersion",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/health"
      }
    },
    {
      "name": "Sign up (development)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/auth/sign-up/email",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo user\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Use an ephemeral local account. Production requires verified email. Postman's cookie jar stores the session; do not export credentials."
      }
    },
    {
      "name": "Sign in",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/auth/sign-in/email",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Current session",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/me"
      }
    },
    {
      "name": "Parse a mandate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/mandates/parse",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Find Sony or Bose headphones below $180. New products only. Automatically spend up to $150. Ask above that. Quantity one. Valid for 24 hours.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Review returned canonical mandate JSON in the app. Parsing grants no purchasing permission."
      }
    },
    {
      "name": "Owned mandates",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/mandates"
      }
    },
    {
      "name": "Simulate a purchase against a mandate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/mandates/{{mandateId}}/simulate",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 16900,\n  \"quantity\": 1,\n  \"condition\": \"NEW\",\n  \"brand\": \"Sony\",\n  \"category\": \"Headphones\",\n  \"merchant\": \"Mandate Demo Store\",\n  \"shipping\": 0,\n  \"tax\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Read-only AgentGuard verdict for a hypothetical purchase (amounts in cents). Returns { simulated, decision, reasonCodes, explanation, mandate, facts }. Creates no proposal, reservation or audit row. 60 per user per minute."
      }
    },
    {
      "name": "Search controlled catalog",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/products/search",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mandateId\": \"{{mandateId}}\",\n  \"query\": \"headphones\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Choose an active owned mandate first. Discovery is explicitly labeled Demo Catalog unless Channel3 is configured."
      }
    },
    {
      "name": "Shopping agent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/agent/chat",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Find Sony headphones and prepare one proposal for review.\",\n  \"mandateId\": \"{{mandateId}}\",\n  \"requestKey\": \"{{shoppingRequestKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Keep the same request key when retrying a request. The model can propose; it cannot approve or pay."
      }
    },
    {
      "name": "Shopping agent (streamed)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/agent/chat/stream",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Find Sony headphones and prepare one proposal for review.\",\n  \"mandateId\": \"{{mandateId}}\",\n  \"requestKey\": \"{{shoppingRequestKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Same body and checks as Shopping agent. Answers text/event-stream: `step` events ({ id, label, status }), then exactly one `result` (the POST /api/agent/chat JSON body, including excludedProducts) or `error` ({ status, error, code? }). Checks that fail before the run starts return ordinary JSON errors."
      }
    },
    {
      "name": "Prepare proposal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/proposals",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mandateId\": \"{{mandateId}}\",\n  \"source\": \"demo\",\n  \"productId\": \"demo-headphones-169\",\n  \"quantity\": 1,\n  \"requestKey\": \"{{proposalRequestKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "No client price, total or currency is accepted."
      }
    },
    {
      "name": "Evaluate proposal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/proposals/{{proposalId}}/evaluate",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Read actual proposal decision",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/proposals/{{proposalId}}",
        "description": "The decision includes a deterministic explanation { decision, headline, summary, approvalCanOverride, checks[] } derived from the recorded verdict."
      }
    },
    {
      "name": "Approve exact proposal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/proposals/{{proposalId}}/approve",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Explicit human action. Hard policy blocks cannot be overridden. Approval does not execute payment."
      }
    },
    {
      "name": "PayPal status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/paypal/status",
        "description": "Returns { configured, environment: \"sandbox\" | \"live\", webhookConfigured }. Never returns credentials."
      }
    },
    {
      "name": "Create Sandbox order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/paypal/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"proposalId\": \"{{proposalId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Explicit Sandbox financial operation. Open the returned PayPal approval URL using a separate personal Sandbox buyer. Returns { payment, approvalUrl, pending }: 202 with pending true and approvalUrl null when PayPal's outcome is unknown (send again to replay the same request ID); 422 PAYPAL_REQUEST_REJECTED when PayPal refused the order (nothing was created)."
      }
    },
    {
      "name": "Capture approved Sandbox order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/paypal/orders/{{paymentId}}/capture",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "paymentId is MandatePay's local payment ID, not a PayPal order ID. Requires actual Sandbox payer approval. Retrying uses server-stored idempotency."
      }
    },
    {
      "name": "Check Sandbox order status",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/paypal/orders/{{paymentId}}/reconcile",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Provider reads only for the local paymentId; never creates an order or capture. Returns { payment, pending } (202 while pending)."
      }
    },
    {
      "name": "Owned orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/orders"
      }
    },
    {
      "name": "Owned order and refunds",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/orders/{{paymentId}}"
      }
    },
    {
      "name": "Partial Sandbox refund",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/payments/{{paymentId}}/refund",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amountMinor\": 2000,\n  \"reason\": \"Item damaged\",\n  \"requestKey\": \"{{refundRequestKey}}\",\n  \"confirmed\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Explicit $20 refund of an owned capture. Set a fresh key only for a new intentional refund; retain this key/details for retries."
      }
    },
    {
      "name": "Check refund status",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/payments/{{paymentId}}/refund-status",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Provider reads only for the payment's pending refunds. 202 while still pending."
      }
    },
    {
      "name": "Saved PayPal method",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/payment-methods/paypal",
        "description": "Returns { paymentMethod } with status NONE, SETUP_PENDING, ACTIVE, REMOVAL_PENDING or REVOKED and currentConsentVersion. The PayPal token ID is never returned."
      }
    },
    {
      "name": "Start saving PayPal (consent)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/payment-methods/paypal/setup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"consent\": true,\n  \"consentVersion\": \"{{vaultConsentVersion}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Set vaultConsentVersion to paymentMethod.currentConsentVersion after reading the consent text in Settings. Returns { paymentMethod, approvalUrl }; approve at PayPal with a personal Sandbox buyer, then send Complete."
      }
    },
    {
      "name": "Complete saving PayPal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/payment-methods/paypal/complete",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Confirms the PayPal approval and stores the encrypted token. Returns { paymentMethod }."
      }
    },
    {
      "name": "Cancel saving PayPal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/payment-methods/paypal/cancel",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Abandons a pending setup. Returns { paymentMethod }."
      }
    },
    {
      "name": "Remove saved PayPal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/payment-methods/paypal/remove",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Deletes the token at PayPal, then revokes it locally. 202 with REMOVAL_PENDING while PayPal has not confirmed."
      }
    },
    {
      "name": "Autopay preview",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/proposals/{{proposalId}}/autopay",
        "description": "Read-only. Returns { autopay: { eligible, reason, paymentMethodStatus, payment } }."
      }
    },
    {
      "name": "Autopay with saved PayPal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/proposals/{{proposalId}}/autopay",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Explicit Sandbox financial operation: pays an AgentGuard ALLOW proposal within the automatic limit buyer-not-present. Returns { autopay: { outcome: PAID | PENDING | FALLBACK | NOT_ELIGIBLE | FAILED, reason, payment }, proposal, decision }; 202 when PENDING. Send again to replay the same request; it never creates a second order."
      }
    },
    {
      "name": "Natural-language dashboard",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/dashboard/query",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"Show everything AgentGuard blocked this week.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Audit timeline",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{appUrl}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{apiUrl}}/api/audit?entityId={{paymentId}}"
      }
    }
  ]
}
