{
  "name": "@mandatepay/admin",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/setup-fonts.mjs && next dev --hostname 127.0.0.1 --port 3001",
    "build": "node ../../scripts/setup-fonts.mjs && node ../../scripts/check-admin-boundaries.mjs && next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint . && node ../../scripts/check-admin-boundaries.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts apps/admin"
  },
  "dependencies": {
    "@mandatepay/ui": "workspace:*",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@mandatepay/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3"
  }
}
