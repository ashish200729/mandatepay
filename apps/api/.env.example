HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=
TEST_DATABASE_URL=
AUTH_SECRET=

# OpenAI-compatible text inference; keys remain server-side.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional live discovery. Leave blank for the clearly labeled Demo Catalog.
CHANNEL3_API_KEY=
PRODUCT_DISCOVERY_MODE=demo
# Fill with credentials from your PayPal Sandbox REST app, not live credentials.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after registering a reachable webhook URL.
PAYPAL_WEBHOOK_ID=
TOKEN_ENCRYPTION_KEY=
