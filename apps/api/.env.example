# Optional API overrides of root .env defaults. Keep only values you override.
# An empty value intentionally clears an inherited setting.
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=
TEST_DATABASE_URL=
AUTH_SECRET=
# Production defaults to verified email and requires a configured sender.
AUTH_REQUIRE_EMAIL_VERIFICATION=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Same value as the web/admin BFFs; required in production (32+ characters).
INTERNAL_PROXY_SECRET=
# Optional trusted proxy hop count for direct API traffic.
TRUST_PROXY=
# Operator demo account script only; the server never reads these.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
DEMO_ACCOUNT_NAME=

# OpenAI-compatible text inference; keys remain server-side.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_RESPONSE_MODE=json_schema
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_REASONING_EFFORT=null

# Optional live discovery. Leave blank for the clearly labeled Demo Catalog.
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com/v1
CHANNEL3_TIMEOUT_MS=15000
CHANNEL3_MAX_RETRIES=1
CHANNEL3_FALLBACK_MODE=disabled
PRODUCT_DISCOVERY_MODE=demo
# Fill with credentials from your PayPal Sandbox REST app, not live credentials.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after registering a reachable webhook URL.
PAYPAL_WEBHOOK_ID=
TOKEN_ENCRYPTION_KEY=
# EC P-256 private JWK for signed mandate credentials (pnpm --silent --filter @mandatepay/api mandate:keygen).
# Required in production; development/test use a temporary per-process key.
MANDATE_SIGNING_KEY=
MANDATE_SIGNING_PREVIOUS_JWKS=
