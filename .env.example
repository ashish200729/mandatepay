# Global defaults for API, web server and Prisma commands. Copy to ignored .env.
# Workspace files override these values; shell/deployment variables win.
# See docs/development/environment.md. Select NODE_ENV through the command/shell.

# Application (web reads only API_URL, APP_URL and INTERNAL_PROXY_SECRET from global files).
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
LOG_LEVEL=info

# Database: provide a dedicated PostgreSQL database for MandatePay.
DATABASE_URL=
TEST_DATABASE_URL=

# Authentication: generate a cryptographically random secret of at least 32 chars.
AUTH_SECRET=
# Required for public production authentication; optional for local development.
AUTH_REQUIRE_EMAIL_VERIFICATION=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Shared by web, admin and API (32+ random chars). Lets the BFFs forward the browser's IP for
# rate limiting. Required in production; optional locally (the API then uses its socket address).
INTERNAL_PROXY_SECRET=
# Optional: number of trusted proxy hops in front of the API for direct traffic. Leave empty
# unless the API is reachable only through that many proxies.
TRUST_PROXY=

# Operator demo account (pnpm --filter @mandatepay/api demo:account). Never commit real values.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
DEMO_ACCOUNT_NAME=

# AI and discovery: server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_RESPONSE_MODE=json_schema
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_REASONING_EFFORT=null

# Discovery. Demo Catalog requires no Channel3 key.
PRODUCT_DISCOVERY_MODE=demo
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com/v1
CHANNEL3_TIMEOUT_MS=15000
CHANNEL3_MAX_RETRIES=1
# Set to demo to serve clearly labelled Demo Catalog results when Channel3 fails.
CHANNEL3_FALLBACK_MODE=disabled

# Per-user request limits for the shopping assistant and AI product comparison.
AGENT_CHAT_RATE_LIMIT_PER_MINUTE=12
CATALOG_COMPARE_RATE_LIMIT_PER_MINUTE=10

# PayPal: sandbox by default. live is an explicit opt-in that needs live credentials and HTTPS URLs.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MAX_RETRIES=2
# Stuck-capture reconciliation worker (pnpm --filter @mandatepay/api worker:reconcile).
PAYMENT_RECONCILE_STALE_MINUTES=10
PAYMENT_RECONCILE_BATCH_SIZE=50

# Token protection: supply a securely generated key when token storage is built.
TOKEN_ENCRYPTION_KEY=

# AP2-shaped mandate credentials (API only). EC P-256 private JWK as one JSON line.
# Generate: pnpm --silent --filter @mandatepay/api mandate:keygen
# Required in production; development/test use a temporary key when unset.
MANDATE_SIGNING_KEY=
# Optional: retired public JWKs ({"keys":[...]}) that still verify older credentials.
MANDATE_SIGNING_PREVIOUS_JWKS=

# AG Studio, Vault, off-session autonomy, voice, price-watch and recurrence
# remain unimplemented. Their planned flags are not runtime switches yet.
