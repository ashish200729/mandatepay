# Planning reference for upcoming phases. The current foundation does not
# automatically load this root file or connect any of the providers below.
# Current API runtime settings belong in apps/api/.env (see its example file).

# Application
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NODE_ENV=development

# Database: provide a dedicated PostgreSQL database for MandatePay.
DATABASE_URL=

# Authentication: required configuration depends on the selected auth provider.
AUTH_SECRET=

# AI and discovery: server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
CHANNEL3_API_KEY=

# PayPal: sandbox only for this implementation and demonstration.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Analytics: determine licensed features/access before integration.
AG_GRID_LICENSE_KEY=

# Token protection: supply a securely generated key when token storage is built.
TOKEN_ENCRYPTION_KEY=

# Stretch execution remains disabled until implemented and verified.
AUTONOMOUS_PAYMENTS_ENABLED=false
FEATURE_CHANNEL3=false
FEATURE_AG_STUDIO=false
FEATURE_PAYPAL_VAULT=false
FEATURE_AUTONOMOUS_PAYMENTS=false
FEATURE_PRICE_WATCH=false
FEATURE_RECURRING_MANDATES=false
FEATURE_VOICE=false
