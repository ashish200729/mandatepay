{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^build", "^typecheck"] },
    "test": {
      "dependsOn": ["^build"],
      "env": ["HOST", "PORT", "WEB_ORIGIN", "LOG_LEVEL", "DATABASE_URL", "TEST_DATABASE_URL"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "WEB_ORIGIN",
        "DATABASE_URL",
        "AUTH_SECRET",
        "APP_URL",
        "API_URL",
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "OPENAI_BASE_URL",
        "CHANNEL3_API_KEY",
        "PAYPAL_ENV",
        "PAYPAL_CLIENT_ID",
        "PAYPAL_CLIENT_SECRET",
        "PAYPAL_WEBHOOK_ID",
        "TOKEN_ENCRYPTION_KEY"
      ]
    }
  }
}
