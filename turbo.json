{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env",
    ".env.*",
    "scripts/environment.*",
    "scripts/register-*-environment.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "DATABASE_URL",
        "API_URL",
        "APP_URL",
        "ADMIN_ORIGIN",
        "ADMIN_ENVIRONMENT",
        "NODE_ENV"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["API_URL", "APP_URL", "ADMIN_ORIGIN", "ADMIN_ENVIRONMENT", "NODE_ENV"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["HOST", "PORT", "WEB_ORIGIN", "LOG_LEVEL", "DATABASE_URL", "TEST_DATABASE_URL"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "HOST",
        "PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "WEB_ORIGIN",
        "ADMIN_ORIGIN",
        "ADMIN_ENVIRONMENT",
        "DATABASE_URL",
        "AUTH_SECRET",
        "AUTH_REQUIRE_EMAIL_VERIFICATION",
        "RESEND_API_KEY",
        "AUTH_EMAIL_FROM",
        "APP_URL",
        "API_URL",
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "OPENAI_BASE_URL",
        "OPENAI_RESPONSE_MODE",
        "OPENAI_TIMEOUT_MS",
        "OPENAI_MAX_RETRIES",
        "OPENAI_MAX_OUTPUT_TOKENS",
        "OPENAI_REASONING_EFFORT",
        "CHANNEL3_API_KEY",
        "CHANNEL3_BASE_URL",
        "CHANNEL3_TIMEOUT_MS",
        "CHANNEL3_MAX_RETRIES",
        "CHANNEL3_FALLBACK_MODE",
        "PRODUCT_DISCOVERY_MODE",
        "PAYPAL_ENV",
        "PAYPAL_CLIENT_ID",
        "PAYPAL_CLIENT_SECRET",
        "PAYPAL_WEBHOOK_ID",
        "TOKEN_ENCRYPTION_KEY"
      ]
    }
  }
}
